post_install() {
    # Fresh install: make the daemon start on boot (matches scripts/install.sh).
    systemctl daemon-reload
    systemctl enable rawaccel.service &>/dev/null || true
}

post_upgrade() {
    systemctl daemon-reload
    # Restart if the user had it running; never re-enable a service they disabled.
    systemctl try-restart rawaccel.service &>/dev/null || true
}

pre_remove() {
    systemctl disable --now rawaccel.service &>/dev/null || true
}